# Copia este archivo a /etc/radicados-amigo.env (chmod 640, dueño root:radicados-amigo)
# y rellena los valores reales. NO lo comitees con datos verdaderos.

# --- SMTP (Gmail con App Password recomendado) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo_dedicado@gmail.com
SMTP_PASS=app_password_de_16_caracteres

# --- Correo ---
EMAIL_FROM=correo_dedicado@gmail.com
EMAIL_TO=alejandro@velasquezcadavid.com
# EMAIL_TO acepta varias direcciones separadas por coma:
# EMAIL_TO=uno@x.com,dos@y.com

# --- Mensaje (opcional, hay defaults razonables en notificar-email.js) ---
# EMAIL_SUBJECT=Reporte radicados — {fecha}
# EMAIL_BODY=Ahí te va. Me contás cómo lo ves.\n\nAtte. Pachito Asistente

# --- Rutas (opcional) ---
# RESULTADOS_DIR=/home/radicados-amigo/app/resultados
