[Unit]
Description=Consulta nocturna de radicados (Rama Judicial)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=radicados
Group=radicados
WorkingDirectory=/home/radicados/app
EnvironmentFile=/etc/radicados.env
Environment=TZ=America/Bogota
Environment=NODE_ENV=production
# Trae cambios recientes de radicados.md (no falla si no hay remoto/red).
ExecStartPre=-/usr/bin/git -C /home/radicados/app pull --ff-only
ExecStart=/usr/bin/node /home/radicados/app/consultar.js
TimeoutStartSec=2h
Nice=10

[Install]
WantedBy=multi-user.target
